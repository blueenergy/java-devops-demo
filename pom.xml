<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.blueenergy.demo</groupId>
  <artifactId>order-demo-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>order-demo-parent</name>
  <description>端到端 DevOps 演示：Spring Boot 3 多模块 + 测试门禁 + 容器化 + K8s 金丝雀发布与回滚</description>

  <modules>
    <module>demo-common</module>
    <module>demo-core</module>
    <module>demo-api</module>
    <!-- demo-coverage 必须排在最后：它要在 verify 阶段读取前面所有模块产出的 jacoco.exec -->
    <module>demo-coverage</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      给 argLine 一个空默认值。JaCoCo 的 prepare-agent 会在运行期把 agent 参数写进这个属性；
      若 JaCoCo 未启用（如 demo-coverage 模块不跑测试），属性未定义会让 @{argLine} 求值失败。
    -->
    <argLine></argLine>

    <!-- 依赖版本 -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- 覆盖 Boot BOM 的 42.7.11：CVE-2026-54291，见 dependencyManagement 里的说明 -->
    <postgresql.version>42.7.14</postgresql.version>

    <!--
      插件版本必须在这里显式钉死。
      spring-boot-dependencies 是 BOM，只管理 <dependencies>，不管理 <plugins>。
      不钉版本时 Maven 会去仓库 metadata 解析最新版——spring-boot-maven-plugin 现在已是 4.x，
      repackage 行为与产物结构都可能变化，构建会在某天毫无征兆地挂掉。
    -->
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <git-commit-id-plugin.version>10.0.1</git-commit-id-plugin.version>

    <!--
      覆盖率门禁阈值。这里只声明数字，真正的判定在 CI 层执行
      （读 demo-coverage 产出的聚合 XML）。
      绝不在模块级用 jacoco:check —— 它只读本模块的 jacoco.exec，没有聚合能力，
      demo-common 这种纯 DTO 模块永远达不到阈值，绑上去必然红。
    -->
    <jacoco.min.line.ratio>0.80</jacoco.min.line.ratio>
    <jacoco.min.branch.ratio>0.70</jacoco.min.branch.ratio>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        PostgreSQL JDBC 驱动版本覆盖。

        背景：Spring Boot 3.5.16 的 BOM 管理 42.7.11，而该版本存在
        CVE-2026-54291（HIGH）—— SCRAM-SHA-256-PLUS 降级导致中间人防护失效。
        Trivy 在 CI 里把它拦了下来，这正是依赖扫描门禁该干的事。

        覆盖方式：在同一份 dependencyManagement 里显式声明版本。
        显式条目优先于 import 进来的 BOM，不需要改 Boot 版本。

        这暴露了「BOM 统一版本」的一个真实代价：
        版本被集中管理后，单个依赖的紧急安全更新需要显式覆盖，
        否则要等下一个 Boot patch 版本才能修。
        判断标准：安全修复等不起，就覆盖；功能升级可以等。

        Trivy 报的修复版本是 42.7.12，这里取当前最新的 42.7.14。
      -->
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>

      <!--
        用 import scope 引入 Boot 的 BOM，而不是把 spring-boot-starter-parent 当父 POM。
        原因：我们需要自定义父 POM 来做多模块聚合与统一插件治理；
        BOM 只带来版本仲裁，不带来 Boot 那套会覆盖我们配置的默认行为。

        注意：Boot 3.5.16 的 BOM 管理 Testcontainers 1.21.4。
        Testcontainers 2.x 已发布，但不要手动升——@ServiceConnection 的集成是按 1.x 写的。
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!--
      资源过滤。自定义父 POM 不会继承 spring-boot-starter-parent 的 resource.delimiter=@ 设置，
      不配的话 application.yml 里的 @project.version@ 不会被替换——
      构建静默通过，运行期才炸。
      用 @ 作定界符是为了不干扰 Spring 自己的 ${SERVER_PORT:8080} 占位符。
    -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/*.yml</include>
          <include>**/*.yaml</include>
          <include>**/*.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/*.yml</exclude>
          <exclude>**/*.yaml</exclude>
          <exclude>**/*.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/*.yml</include>
          <include>**/*.yaml</include>
          <include>**/*.properties</include>
        </includes>
      </testResource>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/*.yml</exclude>
          <exclude>**/*.yaml</exclude>
          <exclude>**/*.properties</exclude>
        </excludes>
      </testResource>
    </testResources>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <!-- Spring 依赖参数名做构造器绑定与 @RequestParam 名称推断，必须保留 -->
            <parameters>true</parameters>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!--
              @{argLine} 是「延迟求值」语法，不是 ${}。
              JaCoCo 的 prepare-agent 在运行期才把 -javaagent 参数写进 argLine 属性；
              写成 ${argLine} 会在配置阶段就求值成空串，把 agent 参数冲掉，覆盖率恒为 0。
              -XX:+EnableDynamicAgentLoading 消除 JDK 21 + Mockito 5 的 self-attach 警告。
            -->
            <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
          <configuration>
            <!--
              只认 @ 这一种定界符，并且关掉默认定界符。

              两个原因：
              1) 若 ${*} 也在跑，application.yml 里的 ${DB_URL:jdbc:...} 这类
                 Spring 占位符会被 Maven 当作属性名试图插值——解析失败时它
                 「碰巧」保持原样，于是看起来没问题，但这是未定义行为，
                 一旦有同名 Maven 属性就静默出错。
              2) 3.5.0 把参数从单数 delimiter 改成了集合 delimiters。
                 写过时的 `delimiter` 不会报错、只有一条被忽略的 WARNING
                 —— 配置悄悄失效而不自知，比直接报错更危险。
            -->
            <delimiters>
              <delimiter>@</delimiter>
            </delimiters>
            <useDefaultDelimiters>false</useDefaultDelimiters>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>io.github.git-commit-id</groupId>
          <artifactId>git-commit-id-maven-plugin</artifactId>
          <version>${git-commit-id-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        测试分层的关键：Surefire 跑单测，Failsafe 跑集成测试。
        Surefire 默认只认 *Test / Test* / *Tests / *TestCase，在 test 阶段执行；
        Failsafe 认 *IT / IT* / *ITCase，在 integration-test 阶段执行。

        这样划分的实际收益：`mvn test` 是秒级的快速反馈循环（改一行业务代码跑一遍），
        `mvn verify` 才付出启动容器、连数据库的代价。CI 里两者都跑，
        但开发者本地迭代时不必每次都等 Testcontainers。

        只写在 pluginManagement 里是不够的 —— 那样插件根本不会执行。
        这个坑很隐蔽：构建全绿，集成测试却一个都没跑，覆盖率也虚高。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>run-integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <!--
                verify 目标不可省略。缺了它，集成测试失败不会让构建失败 ——
                Failsafe 在 integration-test 阶段记录失败，在 verify 阶段才据此判定构建结果。
                只配 integration-test 会让失败的集成测试静默通过。
              -->
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- 构建环境前置校验：版本不对时给出明确报错，而不是几百行编译错误 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                  <message>需要 Maven 3.9+。请用仓库自带的 ./mvnw（它会自动拉取 3.9.16）。</message>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>需要 JDK 21+。当前版本不满足，请检查 JAVA_HOME。</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        JaCoCo：所有模块只做「采集 + 出报告」，不做判定。
        判定统一在 CI 层对聚合报告执行，见 demo-coverage 模块与 .github/workflows/ci.yml。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
