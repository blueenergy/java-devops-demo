root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,pom}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.{md,markdown}]
# Markdown 里行尾两个空格是有意义的换行符，不能裁掉
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab
