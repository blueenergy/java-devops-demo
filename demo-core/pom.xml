<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.blueenergy.demo</groupId>
    <artifactId>order-demo-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>demo-core</artifactId>
  <name>demo-core</name>
  <description>领域层：JPA 实体、仓储、业务服务、数据库迁移。不认识 HTTP。</description>

  <dependencies>
    <dependency>
      <groupId>io.github.blueenergy.demo</groupId>
      <artifactId>demo-common</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!--
      Flyway 10 起把各数据库方言拆成了独立 artifact。
      只引 flyway-core 会在启动时报 "Unsupported Database: PostgreSQL"。
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 只要 micrometer 的 API 来埋点，不引入任何 registry 实现（那是 demo-api 的事） -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <!--
      注意：这里没有 Testcontainers，也没有 @SpringBootTest。
      集成测试放在 demo-api —— 因为 @SpringBootTest 需要启动类，而启动类在 demo-api（它依赖本模块）。
      把 IT 放这里会造成 demo-core → demo-api 的循环依赖。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
